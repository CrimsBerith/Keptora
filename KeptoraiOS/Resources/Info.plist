	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>APP_LIFETIME_PRODUCT_ID</key>
	<string>com.keptora.app.pro.lifetime</string>
	<key>APP_PRIVACY_POLICY_URL</key>
	<string>https://alfagolab.com/keptora/privacy</string>
	<key>APP_SUPPORT_URL</key>
	<string>https://alfagolab.com/keptora/support</string>
	<key>APP_TERMS_OF_USE_URL</key>
	<string>https://www.apple.com/legal/internet-services/itunes/dev/stdeula/</string>
	<key>APP_MARKETING_URL</key>
	<string>https://alfagolab.com/keptora</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>

