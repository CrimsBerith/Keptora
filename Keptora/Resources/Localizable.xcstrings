          }
        }
      }
    },
    "Keptora Quarantine": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora-Quarantäne"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quarantaine Keptora"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora Karantinası"
          }
        }
      }
    },
    "Keptora scans only the photos you selected. You can change access in Settings > Privacy & Security > Photos.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora scannt nur die ausgewählten Fotos. Zugriff änderbar unter Einstellungen > Datenschutz & Sicherheit > Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora analyse uniquement les photos sélectionnées. Vous pouvez modifier l’accès dans Réglages > Confidentialité et sécurité > Photos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora yalnızca seçtiğiniz fotoğrafları tarar. Erişimi Ayarlar > Gizlilik ve Güvenlik > Fotoğraflar bölümünden değiştirebilirsiniz."
          }
        }
      }
    },
    "Keptora settings": {
      "comment": "A label for the settings button.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora-Einstellungen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paramètres de Keptora"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora ayarları"
          }
        }
      }
    },
    "Keptora stores at most 200 timing samples on this Mac. No filenames, paths, hashes, image bytes, or account data are recorded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora speichert höchstens 200 Zeitungsbeispiele auf diesem Mac. Keine Dateinamen, Pfade, Hashes, Bildbyte oder Kontoinformationen werden aufgezeichnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora stocke au maximum 200 échantillons de temps sur ce Mac. Aucun nom de fichier, chemin, hachage, octets d'image ou données de compte n'est enregistré."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora bu Mac'te en fazla 200 zamanlama örneği saklar. Dosya adları, yollar, özetler, görüntü baytları veya hesap verileri kaydedilmez."
          }
        }
      }
    },
    "Keptora uses a SHA-256 digest of the original bytes. Cleanup is available only for exact groups, never visual similarity.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora verwendet einen SHA-256-Hash der Originaldaten. Die Bereinigung ist nur für exakte Gruppen verfügbar, niemals für visuelle Ähnlichkeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora utilise une empreinte SHA-256 des octets d’origine. Le nettoyage est réservé aux groupes exacts, jamais à la similarité visuelle."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora özgün baytların SHA-256 özetini kullanır. Temizleme yalnızca tam kopya gruplarında kullanılabilir; görsel benzerlikte asla kullanılamaz."
          }
        }
      }
    },
    "Keptora verified this item byte for byte. It can be selected because another protected copy remains in this exact group.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora hat dieses Element Byte für Byte verifiziert. Es kann ausgewählt werden, weil eine weitere geschützte Kopie in dieser exakten Gruppe verbleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora a vérifié cet élément octet par octet. Il peut être sélectionné, car une autre copie protégée reste dans ce groupe exact."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora bu öğeyi bayt bayt doğruladı. Bu birebir grupta başka bir korunan kopya kaldığı için seçilebilir."
          }
        }
      }
    },
    "Keptora verifies the signed manifest, original paths, quarantine files, byte counts, and SHA-256 digests before enabling restore.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora überprüft das signierte Manifest, die ursprünglichen Pfade, die Quarantänedateien, die Bytezahlen und die SHA-256-Hashes, bevor die Wiederherstellung freigegeben wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora vérifie le manifeste signé, les chemins d'origine, les fichiers de quarantaine, le nombre d'octets et les empreintes SHA-256 avant d'activer la restauration."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora geri yüklemeyi etkinleştirmeden önce imzalı bildirimi, özgün yolları, karantina dosyalarını, bayt sayılarını ve SHA-256 özetlerini doğrular."
          }
        }
      }
    },
    "Keptora will move reviewed copies into a hidden quarantine folder beside the originals. Nothing is permanently deleted.": {
      "comment": "A description of the functionality of the \"Review Safety Plan\" feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora wird die überprüften Kopien in einen versteckten Quarantäneordner neben den Originalschriften verschieben. Nichts wird dauerhaft gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora transférera les copies examinées dans un dossier de quarantaine caché à côté des originaux. Rien n'est supprimé définitivement."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora incelenen kopyaları orijinallerin yanındaki gizli karantina klasörüne taşır. Hiçbir şey kalıcı olarak silinmez."
          }
        }
      }
    },
