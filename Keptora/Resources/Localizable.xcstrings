    "%@ verified exact copies will move to Recently Deleted. With iCloud Photos, removal syncs to your other devices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geprüfte exakte Kopien werden in „Zuletzt gelöscht“ verschoben. Mit iCloud-Fotos wird das Entfernen geräteübergreifend synchronisiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ copies exactes vérifiées seront placées dans Suppressions récentes. Avec Photos iCloud, la suppression se synchronise sur vos autres appareils."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanmış %@ tam kopya Son Silinenler’e taşınacak. iCloud Fotoğraflar ile kaldırma diğer cihazlarınıza eşzamanlanır."
          }
        }
      }
    },
