        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde einen nicht verfügbaren Ordner unter Quellen erneut."
          }
        }
      }
    },
    "Connected sources are scanned together. Add folders from iCloud Drive, On My iPhone, or another provider in Files once; keep them connected for future scans.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı kaynaklar birlikte taranır. Dosyalar üzerinden iCloud Drive, iPhone’umda veya başka bir sağlayıcıdaki klasörleri bir kez ekle; sonraki taramalar için bağlı tut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sources connectées sont analysées ensemble. Ajoutez une fois les dossiers d’iCloud Drive, Sur mon iPhone ou d’un autre fournisseur dans Fichiers et gardez-les connectés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbundene Quellen werden gemeinsam gescannt. Füge Ordner aus iCloud Drive, Auf meinem iPhone oder anderen Anbietern in Dateien einmal hinzu und behalte die Verbindung."
          }
        }
      }
    },
