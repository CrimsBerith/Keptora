    "Open Photos or a folder. Select any photo or video without waiting for duplicate analysis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Photos or a folder. Select any photo or video without waiting for duplicate analysis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar’ı veya bir klasörü açın. Kopya analizini beklemeden istediğiniz fotoğraf veya videoyu seçin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Photos ou un dossier. Sélectionnez des photos et vidéos sans attendre l’analyse des doublons."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Fotos oder einen Ordner. Wählen Sie Fotos und Videos aus, ohne auf die Duplikatanalyse zu warten."
          }
        }
      }
    },
    "Photos can be recovered from Recently Deleted for up to 30 days unless deleted sooner. Folder files stay in a recovery area until you restore them.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar daha önce kalıcı silinmedikçe en fazla 30 gün boyunca Son Silinenler’den kurtarılabilir. Klasör dosyaları siz geri yükleyene kadar kurtarma alanında kalır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos lassen sich bis zu 30 Tage lang aus „Zuletzt gelöscht“ wiederherstellen, sofern sie nicht vorher endgültig gelöscht werden. Ordnerdateien bleiben in einem Wiederherstellungsbereich, bis du sie wiederherstellst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos peuvent être récupérées dans Supprimés récemment pendant 30 jours au maximum, sauf suppression définitive plus tôt. Les fichiers de dossier restent dans une zone de récupération jusqu’à leur restauration."
          }
        }
      },
      "extractionState": "manual"
    },
