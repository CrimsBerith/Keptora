          }
        }
      }
    },
    "Photos is not available on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos ist auf diesem Gerät nicht verfügbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos n’est pas disponible sur cet appareil."
          }
