    "Approve Photos and connect folders once. Future scans combine every connected source.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve Photos and connect folders once. Future scans combine every connected source."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar iznini ver ve klasörleri bir kez bağla. Sonraki taramalar bağlı tüm kaynakları birlikte tarar."
          }
        },
