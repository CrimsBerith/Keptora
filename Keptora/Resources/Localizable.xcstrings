    "%1$lld manually reviewed similar videos will move to Recently Deleted. The keeper stays protected. With iCloud Photos, removal syncs to your other devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld manually reviewed similar videos will move to Recently Deleted. The keeper stays protected. With iCloud Photos, removal syncs to your other devices."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuel olarak incelenen %1$lld benzer video Son Silinenler albümüne taşınacaktır. Korunan kopya güvende kalır. iCloud Fotoğraflar ile silme işlemi diğer aygıtlarınızla eşzamanlanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld manuell überprüfte ähnliche Videos werden in „Zuletzt gelöscht“ verschoben. Das Original bleibt geschützt. Mit iCloud-Fotos wird das Entfernen auf andere Geräte synchronisiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld vidéos similaires examinées manuellement seront déplacées vers « Supprimés récemment ». La copie conservée reste protégée. Avec Photos iCloud, la suppression est synchronisée sur vos autres appareils."
          }
        }
      }
    },
    "%1$lld verified exact copies will move to Recently Deleted. The keeper stays protected. With iCloud Photos, removal syncs to your other devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld verified exact copies will move to Recently Deleted. The keeper stays protected. With iCloud Photos, removal syncs to your other devices."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanmış %1$lld birebir kopya Son Silinenler albümüne taşınacaktır. Korunan kopya güvende kalır. iCloud Fotoğraflar ile silme işlemi diğer aygıtlarınızla eşzamanlanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld verifizierte exakte Kopien werden in „Zuletzt gelöscht“ verschoben. Das Original bleibt geschützt. Mit iCloud-Fotos wird das Entfernen auf andere Geräte synchronisiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld copies exactes vérifiées seront déplacées vers « Supprimés récemment ». La copie conservée reste protégée. Avec Photos iCloud, la suppression est synchronisée sur vos autres appareils."
          }
        }
      }
    },
