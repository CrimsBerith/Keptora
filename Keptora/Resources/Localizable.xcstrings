      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar → Son Silinenler"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos → Supprimés récemment"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos → Zuletzt gelöscht"
          }
        }
      }
    },
    "Recovery Folder": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma Klasörü"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier de récupération"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungsordner"
          }
        }
      }
    },
    "Moves in connected cloud folders may sync to other devices.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı bulut klasörlerindeki taşıma işlemleri diğer cihazlara yansıyabilir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les déplacements dans les dossiers cloud connectés peuvent être synchronisés sur d’autres appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebungen in verbundenen Cloud-Ordnern können mit anderen Geräten synchronisiert werden."
          }
        }
      }
    },
    "Photos items move to Recently Deleted and iCloud changes sync across devices. Files move to a recovery folder on the same storage; this does not free disk space. Completed steps appear in History if cleanup stops partway.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar öğeleri Son Silinenler’e taşınır; iCloud değişiklikleri diğer cihazlara yansır. Dosyalar aynı depolamadaki kurtarma klasörüne taşınır; bu işlem alan boşaltmaz. Temizlik yarıda kalırsa tamamlanan adımlar Geçmiş’te görünür."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments Photos vont dans Supprimés récemment et les changements iCloud se synchronisent entre appareils. Les fichiers vont dans un dossier de récupération sur le même stockage, sans libérer d’espace. En cas d’interruption, les étapes terminées figurent dans l’historique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos werden nach Zuletzt gelöscht verschoben; iCloud-Änderungen werden synchronisiert. Dateien kommen in einen Wiederherstellungsordner auf demselben Speicher, ohne Speicherplatz freizugeben. Bei einer Unterbrechung erscheinen abgeschlossene Schritte im Verlauf."
          }
        }
      }
    },
    "Completed steps appear in History. Photos items go to Recently Deleted; files go to their source recovery folder.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanan adımlar Geçmiş’te görünür. Fotoğraflar Son Silinenler’e, dosyalar kaynaklarının kurtarma klasörüne taşınır."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étapes terminées figurent dans l’historique. Photos va dans Supprimés récemment, les fichiers dans le dossier de récupération de leur source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschlossene Schritte erscheinen im Verlauf. Fotos kommen nach Zuletzt gelöscht, Dateien in den Wiederherstellungsordner ihrer Quelle."
          }
        }
      }
    },
