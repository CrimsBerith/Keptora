    "The protected keeper stays in place. Files move to a reversible Keptora Quarantine folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geschützte Original bleibt erhalten. Dateien werden in die wiederherstellbare Keptora-Quarantäne verschoben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
