    "Your photos and decisions are not touched. The next scan will take longer because fingerprints are recomputed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos and decisions are not touched. The next scan will take longer because fingerprints are recomputed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflarınıza ve kararlarınıza dokunulmaz. Parmak izleri yeniden hesaplanacağı için bir sonraki tarama daha uzun sürer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos und Entscheidungen bleiben unberührt. Der nächste Scan dauert länger, da Fingerabdrücke neu berechnet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos photos et décisions ne sont pas modifiées. La prochaine analyse prendra plus de temps car les empreintes sont recalculées."
          }
        }
      }
    },
