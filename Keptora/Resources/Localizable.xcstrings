        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können diese Dateien jederzeit unter Verlauf & Wiederherstellung wiederherstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez restaurer ces fichiers à tout moment depuis Historique et restauration."
