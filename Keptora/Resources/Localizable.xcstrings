            "value": "Connectez Photos et vos dossiers une fois. Choisissez les sources à inclure dans chaque analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie Fotos und Ordner einmal. Wählen Sie die Quellen für jeden Scan."
          }
        }
      }
    },
    "Full Photos access includes iCloud Photos. Limited access shows only the items you approve.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Photos access includes iCloud Photos. Limited access shows only the items you approve."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam Fotoğraflar erişimi iCloud Fotoğrafları da kapsar. Sınırlı erişimde yalnızca izin verdiğiniz öğeler görünür."
          }
        },
        "fr": {
