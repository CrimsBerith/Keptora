          }
        }
      }
    },
    "Keptora always skips hidden items, package contents, .Keptora Quarantine, .git and node_modules. Custom rules apply on the next scan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora überspringt immer versteckte Elemente, Paketinhalte, .Keptora Quarantine, .git und node_modules. Benutzerdefinierte Regeln gelten beim nächsten Scan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora saute toujours les éléments cachés, le contenu des paquets, .Keptora Quarantine, .git et node_modules. Des règles personnalisées s'appliquent lors de la prochaine vérification."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora gizli öğeleri, paket içeriklerini, .Keptora Quarantine, .git ve node_modules klasörlerini her zaman atlar. Özel kurallar sonraki taramada uygulanır."
          }
        }
      }
    },
    "Keptora asks only when you choose this source.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora fragt nur bei Auswahl dieser Quelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora ne demande que lorsque vous choisissez cette source."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora yalnızca bu kaynağı seçtiğinizde izin ister."
          }
        }
      }
    },
    "Keptora by AlfagoLab": {
      "localizations": {
        "de": {
