    "Full Photos access includes iCloud Photos and WhatsApp media saved to Photos. Limited access shows only the items you approve.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Photos access includes iCloud Photos and WhatsApp media saved to Photos. Limited access shows only the items you approve."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam Fotoğraflar erişimi, iCloud Fotoğrafları ve Fotoğraflar’a kaydedilmiş WhatsApp medyasını kapsar. Sınırlı erişimde yalnızca izin verdiğin öğeler görünür."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès complet comprend Photos iCloud et les médias WhatsApp enregistrés dans Photos. L’accès limité affiche uniquement les éléments autorisés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständiger Fotozugriff umfasst iCloud-Fotos und in Fotos gespeicherte WhatsApp-Medien. Eingeschränkter Zugriff zeigt nur freigegebene Objekte."
          }
        }
      }
    },
    "WhatsApp storage & chat media": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp storage & chat media"
          }
