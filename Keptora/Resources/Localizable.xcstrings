    "Add every non-keeper exact duplicate across all groups to the reversible Safety Plan.": {
      "comment": "A button that adds every non-keeper exact duplicate across all groups to the reversible Safety Plan.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle exakten Duplikate außer dem geschützten Original aus allen Gruppen zum umkehrbaren Sicherheitsplan hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter toutes les copies exactes sauf l'original protégé au plan de sécurité réversible."
