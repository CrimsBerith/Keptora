          "stringUnit": {
            "state": "translated",
            "value": "L'écran ne peut pas être fermé tant que l'opération n'est pas terminée."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem tamamlanana kadar ekran açık kalır."
          }
        }
      }
    },
    "The screen cannot be closed until the purchase operation finishes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm kann nicht geschlossen werden, bis die Kaufvorgabe abgeschlossen ist."
          }
        },
        "fr": {
          "stringUnit": {
