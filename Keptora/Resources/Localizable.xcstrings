          }
        }
      }
    },
    "Photos includes iCloud Photos and saved WhatsApp albums. Files includes the folders you connect. Private chat storage is excluded.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar; izin verilen galeri, iCloud Fotoğrafları ve kaydedilmiş WhatsApp albümlerini kapsar. Dosyalar; bağladığın klasörleri kapsar. Özel sohbet depolamasına erişilemez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos comprend les éléments autorisés, Photos iCloud et les albums WhatsApp enregistrés. Fichiers comprend les dossiers connectés. Le stockage privé des conversations est inaccessible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos umfasst freigegebene Fotos, iCloud-Fotos und gespeicherte WhatsApp-Alben. Dateien umfasst verbundene Ordner. Privater Chatspeicher ist nicht zugänglich."
          }
        }
      }
    },
    "Some items in this source are unavailable. Reconnect or check access.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynaktaki bazı öğelere erişilemiyor. Kaynağı yeniden bağla veya izinleri kontrol et."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains éléments de cette source sont indisponibles. Reconnectez-la ou vérifiez les autorisations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Elemente dieser Quelle sind nicht verfügbar. Verbinde sie erneut oder prüfe die Zugriffsrechte."
          }
        }
      }
    },
    "Reconnect an unavailable folder in Sources.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilemeyen bir klasörü Kaynaklar bölümünden yeniden bağla."
          }
        },
        "fr": {
          "stringUnit": {
