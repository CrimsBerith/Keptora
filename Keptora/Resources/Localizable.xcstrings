    "Keptora scans only what you choose. Photos, fingerprints, and review decisions never leave your device.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora yalnızca seçtiğiniz içeriği tarar. Fotoğraflar, parmak izleri ve inceleme kararları cihazınızdan çıkmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora scannt nur, was du auswählst. Fotos, Fingerabdrücke und Entscheidungen verlassen nie dein Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keptora n’analyse que ce que vous choisissez. Les photos, empreintes et décisions ne quittent jamais votre appareil."
          }
        }
      },
      "extractionState": "manual"
    },
