      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportierte JSON kann den ausgewählten Quellpfad und den aktuellen Dateinamen enthalten. Vor dem Teilen prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le JSON exporté peut inclure le chemin de source sélectionné et le nom de fichier actuel. Vérifiez-le avant de le partager."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışa aktarılan JSON, seçilen kaynak yolunu ve geçerli dosya adını içerebilir. Paylaşmadan önce inceleyin."
          }
        }
      }
    },
    "External volume connected": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Externes Volumen angeschlossen"
          }
        },
