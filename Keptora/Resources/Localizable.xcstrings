            "state": "translated",
            "value": "Keptora in Systemeinstellungen > Datenschutz & Sicherheit > Fotos aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Keptora dans Paramètres système > Confidentialité et sécurité > Photos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
