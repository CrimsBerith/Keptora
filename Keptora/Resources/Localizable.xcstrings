    "This will add %@ copies totaling %@ from every exact group. Protected keepers stay untouched, and nothing moves until you confirm the Safety Plan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden %@ Kopien mit insgesamt %@ aus allen exakten Gruppen zum Plan hinzugefügt. Geschützte Kopien bleiben unberührt; nichts wird verschoben, bevor der Sicherheitsplan bestätigt wird."
          }
        },
        "fr": {
          "stringUnit": {
