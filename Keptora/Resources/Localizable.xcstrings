    },
    "The Safety Plan is stale because exact-review decisions changed after preparation. Regenerate it before moving files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Safety Plan is stale because exact-review decisions changed after preparation. Regenerate it before moving files."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırlıktan sonra birebir inceleme kararları değiştiği için Güvenlik Planı güncelliğini yitirdi. Dosyaları taşımadan önce yeniden oluşturun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sicherheitsplan ist veraltet, da sich Entscheidungen nach der Vorbereitung geändert haben. Vor dem Verschieben neu erstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan de sécurité est obsolète car les décisions ont changé après sa préparation. Régénérez-le avant de déplacer des fichiers."
          }
        }
      }
    },
    "Keptora could not load its local manifest signing key.": {
