    "Choose Pictures, Downloads, iCloud Drive or another cloud folder. Keptora remembers folders you approve; other apps' private storage is unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Pictures, Downloads, iCloud Drive or another cloud folder. Keptora remembers folders you approve; other apps' private storage is unavailable."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resimler, İndirilenler, iCloud Drive veya başka bir bulut klasörünü seç. Keptora izin verdiğin klasörleri hatırlar; diğer uygulamaların özel depolaması erişime kapalıdır."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Images, Téléchargements, iCloud Drive ou un autre dossier cloud. Keptora mémorise les dossiers autorisés ; le stockage privé des autres apps reste inaccessible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Bilder, Downloads, iCloud Drive oder einen anderen Cloud-Ordner. Keptora merkt sich freigegebene Ordner; der private Speicher anderer Apps ist nicht zugänglich."
          }
        }
      }
    },
    "Export the chat with media on your phone, transfer it to your Mac, extract the ZIP, then connect the extracted folder to view its photos and videos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export the chat with media on your phone, transfer it to your Mac, extract the ZIP, then connect the extracted folder to view its photos and videos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonda sohbeti medyasıyla dışa aktar, Mac’e taşı, ZIP’i aç ve fotoğraf ve videolarını görmek için çıkan klasörü bağla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez la discussion avec ses médias sur votre téléphone, transférez-la sur votre Mac, décompressez le ZIP et connectez le dossier extrait pour afficher ses photos et vidéos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere den Chat mit Medien auf deinem Telefon, übertrage ihn auf den Mac, entpacke die ZIP-Datei und verbinde den entpackten Ordner, um die Fotos und Videos anzusehen."
          }
        }
      }
    },
    "No camera, microphone, contacts or live location permission is needed. Existing photo details are read only from media you approve.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera, microphone, contacts or live location permission is needed. Existing photo details are read only from media you approve."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera, mikrofon, kişiler veya canlı konum izni gerekmez. Mevcut fotoğraf bilgileri yalnızca izin verdiğin medyadan okunur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune autorisation de caméra, de microphone, de contacts ou de localisation en direct n’est nécessaire. Les informations existantes sont lues uniquement dans les médias autorisés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera-, Mikrofon-, Kontakt- oder Live-Standortzugriff ist nicht erforderlich. Vorhandene Fotodaten werden nur aus freigegebenen Medien gelesen."
          }
        }
      }
    },
    "You can continue without access and add sources later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can continue without access and add sources later."
