          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korunan ana öğe yerinde kalır. Dosyalar geri alınabilir Keptora Karantinası klasörüne taşınır."
          }
        }
      }
    },
    "The purchase could not be verified.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht verifiziert werden."
          }
