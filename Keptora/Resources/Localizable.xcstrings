    "With iCloud Photos, removal syncs to your other devices. Apple Photos keeps items in Recently Deleted for up to 30 days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit iCloud-Fotos wird das Entfernen geräteübergreifend synchronisiert. Apple Fotos bewahrt Objekte bis zu 30 Tage unter „Zuletzt gelöscht“ auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
