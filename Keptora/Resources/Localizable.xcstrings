          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp-Speicher und Chatmedien"
          }
        }
      }
    },
    "Open WhatsApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open WhatsApp"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp’ı aç"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir WhatsApp"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp öffnen"
          }
        }
      }
    },
    "To view chat media here: in WhatsApp, export the chat with media, save it to Files, extract the ZIP, then connect the extracted folder. Keptora displays the exported photos and videos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To view chat media here: in WhatsApp, export the chat with media, save it to Files, extract the ZIP, then connect the extracted folder. Keptora displays the exported photos and videos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet medyasını burada görmek için WhatsApp’ta sohbeti medyasıyla dışa aktar, Dosyalar’a kaydet, ZIP’i aç ve çıkan klasörü bağla. Keptora dışa aktarılan fotoğraf ve videoları gösterir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour afficher les médias ici, exportez la discussion avec ses médias dans WhatsApp, enregistrez-la dans Fichiers, décompressez le ZIP et connectez le dossier extrait. Keptora affiche les photos et vidéos exportées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere den Chat in WhatsApp mit Medien, sichere ihn in Dateien, entpacke die ZIP-Datei und verbinde den entpackten Ordner. Keptora zeigt die exportierten Fotos und Videos an."
          }
        }
      }
    },
    "Removing exported or saved copies does not free the original WhatsApp chat storage.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing exported or saved copies does not free the original WhatsApp chat storage."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışa aktarılmış veya kaydedilmiş kopyaları kaldırmak, WhatsApp’taki asıl sohbet deposunda yer açmaz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les copies exportées ou enregistrées ne libère pas le stockage de la discussion d’origine dans WhatsApp."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Entfernen exportierter oder gespeicherter Kopien gibt keinen Speicher im ursprünglichen WhatsApp-Chat frei."
          }
        }
      }
    },
    "WhatsApp could not be opened": {
